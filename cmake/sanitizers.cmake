set(ANYGBA_SANITIZE "" CACHE STRING "Sanitizers for project targets: empty, address, undefined, or address;undefined")

function(anygba_enable_sanitizers target)
  if(NOT ANYGBA_SANITIZE)
    return()
  endif()
  if(MSVC)
    if("undefined" IN_LIST ANYGBA_SANITIZE)
      message(FATAL_ERROR "MSVC supports only ANYGBA_SANITIZE=address")
    endif()
    target_compile_options(${target} PRIVATE /fsanitize=address)
  else()
    list(JOIN ANYGBA_SANITIZE "," flags)
    target_compile_options(${target} PRIVATE -fsanitize=${flags} -fno-omit-frame-pointer)
    target_link_options(${target} PRIVATE -fsanitize=${flags})
  endif()
endfunction()

function(anygba_configure_target target)
  anygba_set_warnings(${target})
  anygba_enable_sanitizers(${target})
endfunction()
